#!/bin/sh
# Refuse a push whose new commits contain personal or office-specific data, or a non-noreply email.
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                       # deleting a branch publishes nothing
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha --not --remotes"; else range="$remote_sha..$local_sha"; fi
  # shellcheck disable=SC2086
  python3 "$root/scripts/privacy_check.py" --history $range || status=1
done
python3 "$root/scripts/privacy_check.py" || status=1
[ $status -eq 0 ] || echo "push blocked by privacy check — remove the flagged data first" >&2
exit $status
